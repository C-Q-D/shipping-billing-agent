# LLM 配置（空密钥可运行离线样例。真实密钥仅写入本地 .env 或进程环境）
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# 仅在 LLM_API_KEY 为空且端点为 HTTPS api.deepseek.com 时回退读取
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TRUST_ENV=false
LLM_PROXY_URL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=0

# 外部 OCR 网关配置（默认直连绕过本机代理防 SSL EOF）
OCR_GATEWAY_URL=https://ocr.example.com/ai/process
OCR_TRUST_ENV=false
OCR_PROXY_URL=
OCR_CONNECT_TIMEOUT_SECONDS=10
OCR_READ_TIMEOUT_SECONDS=300
OCR_TASK=orderChange

# 可选：自有受控公网对象存储中转基址（默认空=禁用，严禁未授权外传原件）
PUBLIC_RELAY_BASE_URL=
RELAY_PRESIGN_TTL_SECONDS=300

# 本地服务与持久化配置（默认仅监听回环地址 127.0.0.1）
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_REMOTE_BIND=false
APP_DATA_DIR=data
SQLITE_DB_PATH=data/shipping_billing.db

# Harness 直接读取进程环境中的两个变量。缺省从仓库根目录 local_samples/ 发现本地样本
# SHIPPING_BILLING_REAL_SAMPLES_DIR=
# SHIPPING_BILLING_OCR_SAMPLE_URL=
