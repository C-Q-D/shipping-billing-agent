# LLM 配置（默认 OpenAI 兼容端点；当 LLM_BASE_URL 为空或主机精确为 api.deepseek.com 时允许回退读取 DEEPSEEK_API_KEY）
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TRUST_ENV=false
LLM_PROXY_URL=

# 指定外部 OCR 网关配置（默认直连绕过本机代理防 SSL EOF）
OCR_GATEWAY_URL=https://gateway.pltplt.com/ai/process
OCR_TRUST_ENV=false
OCR_PROXY_URL=
OCR_CONNECT_TIMEOUT_SECONDS=10
OCR_READ_TIMEOUT_SECONDS=300

# 可选：自有受控公网对象存储中转基址（默认空=禁用，严禁未授权外传原件）
PUBLIC_RELAY_BASE_URL=

# 本地服务与持久化配置（默认仅监听回环地址 127.0.0.1）
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_REMOTE_BIND=false
APP_DATA_DIR=data
SQLITE_DB_PATH=data/shipping_billing.db
