FROM nginx:1.27-alpine
RUN apk add --no-cache apache2-utils \
 && touch /etc/nginx/allowlist.conf /etc/nginx/realip.conf /etc/nginx/auth.conf
COPY deploy/nginx-proxy-common.conf /etc/nginx/proxy_common.conf
COPY deploy/nginx-basic-auth.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker-entrypoint-nginx.sh /usr/local/bin/docker-entrypoint-nginx.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint-nginx.sh \
 && chmod 755 /usr/local/bin/docker-entrypoint-nginx.sh
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-nginx.sh"]
