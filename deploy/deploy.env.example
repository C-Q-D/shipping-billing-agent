# 部署环境配置示例（请复制为仓库根目录 .env 再启动 docker compose，切勿提交真实 .env）

# 对外绑定与访客访问口令（推荐使用网页版口令 APP_ACCESS_PASSCODE，兼容桌面/微信/飞书内置浏览器；至少 8 位）
DEPLOY_BIND_IP=0.0.0.0
DEPLOY_PORT=8080
APP_ACCESS_PASSCODE=
APP_ACCESS_SESSION_HOURS=24

# 可选前置 Nginx HTTP Basic Auth（留空则不弹原生浏览器弹窗，直接展示网页版口令登录页）
BASIC_AUTH_USER=reviewer
BASIC_AUTH_PASS=

# 可选 IP/CIDR 白名单（逗号分隔；留空不限制来源 IP，配置后将自动放行本机回环并拒绝其余公网 IP）
# ALLOWED_CIDRS=203.0.113.10/32,198.51.100.0/24
# 若前方另有 Caddy/反代容器代理，填入其网段或 IP（逗号分隔）以还原 X-Real-IP 真实访客地址用于限流与白名单
# TRUSTED_PROXY_CIDRS=172.18.0.0/16

# 应用层限流、每日解析额度、并发与临时链接到期控制（防止公网刷爆 DeepSeek 额度或占用资源）
APP_TRUST_PROXY_HEADERS=true
APP_RATE_LIMIT_PER_MINUTE=180
APP_HEAVY_RATE_LIMIT_PER_MINUTE=6
APP_DAILY_HEAVY_QUOTA=60
APP_MAX_CONCURRENT_HEAVY=2
APP_DISABLE_LIVE_EVAL=true
# 可选 ISO-8601 到期时间（到期后除健康检查外全站自动返回 403；留空表示暂不限时）
# APP_ACCESS_EXPIRES_AT=2026-12-31T23:59:59+08:00
APP_MEM_LIMIT=1536m

# 模型配置（接入真实大模型进行抽取与核验；留空则以纯确定性规则模式运行）
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# OCR 网关与回退配置
OCR_GATEWAY_URL=https://ocr.example.com/ai/process
OCR_TASK=orderChange
OCR_TRUST_ENV=false

# 如走外部 HTTPS 反代（例如绑定独立域名），可补充显式允许 Origin 列表（JSON 数组）
# APP_ALLOWED_ORIGINS=["https://billing-demo.example.com"]
